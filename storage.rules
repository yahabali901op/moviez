rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'REPLACE_WITH_ADMIN_UID';
    }
    match /movies/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /posters/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}